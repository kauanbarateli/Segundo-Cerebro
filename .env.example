# Demonstration is the default. This file contains no credentials.
APP_MODE=demo
APP_URL=http://localhost:3000

# Fill only after manually preparing a NEW project in the personal organization.
# Never reuse BlackSheep/VOE projects or credentials. Keep actual secrets outside
# synchronized folders; production values belong in the hosting environment vault.
# All names below are server-only. Do not prefix them with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Generate independent cryptographically random values (at least 32 bytes each).
# AUTH_STATE_SECRET signs short recovery/completion cookies.
# AUTH_RATE_LIMIT_SECRET hashes limiter subjects; neither is a Supabase key.
AUTH_STATE_SECRET=
AUTH_RATE_LIMIT_SECRET=

# Independent server-only Admin commitment (minimum32random bytes).
ADMIN_COMMAND_SECRET=

# Private Storage: RECOMMENDED defaults; no quotas are silently inherited from VOE.
DRIVE_QUOTA_BYTES=1073741824
DRIVE_MAX_FILE_BYTES=26214400
CRON_SECRET=

# Personal Google Calendar OAuth, read-only scope. Configure manually.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_STATE_SECRET=
GOOGLE_CALENDAR_TOKEN_KEY=
GOOGLE_CALENDAR_TOKEN_KEY_ID=
# Optional rotation keyring, JSON of previous key IDs to independent base64 keys.
# Keep this server-only value in the hosting secret vault, never in Git.
GOOGLE_CALENDAR_TOKEN_KEYS=
GOOGLE_CALENDAR_CRON_SECRET=

# Optional server-only personal Sentry DSN. No logs, replay or automatic tracing.
SENTRY_DSN=

# Auth in APP_MODE=supabase requires SUPABASE_* and AUTH_* above.
# Each additional integration validates its own configuration when requested.
# APP_URL and SUPABASE_URL must be HTTPS in production, without path/query/fragment.
