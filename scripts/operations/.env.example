# Operator-only names. NEVER copy actual secrets into the repository, app .env, or OneDrive.
# Supply through the operator process environment / a protected external DPAPI profile.
# Fixed personal source: rishenjoikgmfubmnfiu. No business/VOE project is accepted.
SC_BACKUP_ENCRYPTION_KEY=
SC_BACKUP_KEY_ID=
SC_BACKUP_DESTINATION=
SC_BACKUP_PG_DUMP=
# Must be YES only after pausing all writers, uploads and cleanup/sync cron jobs.
SC_BACKUP_QUIESCED=
SC_BACKUP_SUPABASE_URL=
